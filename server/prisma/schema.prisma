// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Requester
  ITStaff
  Administrator
}

enum TicketStatus {
  New
  Open
  InProgress
  WaitingForRequester
  Resolved
  Closed
  Reopened
  Cancelled
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role     @default(Requester)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())

  submittedTickets Ticket[]        @relation("TicketRequester")
  ownedTickets     Ticket[]        @relation("TicketOwner")
  comments         PublicComment[]
  internalNotes    InternalNote[]
  actionsPerformed ActionTaken[]   @relation("ActionPerformedBy")
  actionsEdited    ActionTaken[]   @relation("ActionEditedBy")
}

model RelatedSystem {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  isActive Boolean  @default(true)
  tickets  Ticket[]
}

model Ticket {
  id                Int          @id @default(autoincrement())
  ticketNumber      String       @unique
  summary           String
  description       String
  requestedPriority String
  itPriority        String?
  version           Int          @default(1)
  status            TicketStatus @default(New)
  resolutionSummary String?
  resolvedAt        DateTime?
  closedAt          DateTime?
  requesterResolvedIndicatedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  requesterId Int
  requester   User @relation("TicketRequester", fields: [requesterId], references: [id])

  ticketOwnerId Int?
  ticketOwner   User? @relation("TicketOwner", fields: [ticketOwnerId], references: [id])

  categoryId      Int
  category        Category      @relation(fields: [categoryId], references: [id])
  relatedSystemId Int
  relatedSystem   RelatedSystem @relation(fields: [relatedSystemId], references: [id])

  attachments   Attachment[]
  comments      PublicComment[]
  internalNotes InternalNote[]
  actionsTaken  ActionTaken[]

  @@index([status, updatedAt])
  @@index([ticketOwnerId, status])
  @@index([requesterId, status])
}

model ActionTaken {
  id                  Int       @id @default(autoincrement())
  ticketId            Int
  ticket              Ticket    @relation(fields: [ticketId], references: [id])
  actionDateTime      DateTime
  description         String
  result              String
  performedById       Int
  performedBy         User      @relation("ActionPerformedBy", fields: [performedById], references: [id])
  followUpRequired    Boolean   @default(false)
  followUpNote        String?
  followUpCompletedAt DateTime?
  attachmentNotes     String?
  clientRequestId     String
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lastEditedById      Int?
  lastEditedBy        User?     @relation("ActionEditedBy", fields: [lastEditedById], references: [id])

  @@unique([performedById, clientRequestId])
  @@index([ticketId, actionDateTime, id])
  @@index([performedById, followUpRequired, followUpCompletedAt])
}

model Attachment {
  id           Int      @id @default(autoincrement())
  originalName String
  storagePath  String
  isRemoved    Boolean  @default(false)
  createdAt    DateTime @default(now())

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())

  // Relations
  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())

  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  authorId Int
  author   User @relation(fields: [authorId], references: [id])
}
